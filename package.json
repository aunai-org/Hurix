{
  "name": "hurrix",
  "version": "0.1.0",
  "private": true,
  "description": "Tropical cyclones on a 3D globe, from live infrared satellite imagery, with 3D cloud-top and volumetric storm views.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "notices": "node scripts/notices.mjs",
    "data": "sh pipeline/run.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
